namespace Tidewise

Country(国家): EntityType
    desc: 表示拥有 ISO 3166-1 alpha-2 稳定代码的国家或地区对象及其核心静态事实
    properties:
        id(国家标识): Text
            desc: 国家稳定主标识，由 COU 前缀直接连接 canonical lowercase UUID
            constraint: NotNull, Regular="^COU[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        code(国家代码): Text
            desc: ISO 3166-1 alpha-2 全大写两位国家或地区代码
            constraint: NotNull, Regular="^[A-Z]{2}$"
        name(国家中文名称): Text
            desc: 国家的中文简称
            constraint: NotNull
        nameEn(国家英文名称): Text
            desc: 国家的英文简称
            constraint: NotNull
        strategicPositioning(战略定位): Text
            desc: 国家的可选战略定位描述
        keyResources(关键资源): Text
            desc: 国家的可选关键战略资源描述
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的国家事实创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的国家事实最近变更时间
            constraint: NotNull
    relations:
        regions(所属区域): Region
            desc: 国家所属的零个或多个 Region 对象；OpenSPG relation 表达多值关系集合，由 country_region_links 持久化
