namespace Tidewise

Concept(概念): EntityType
    desc: 表示跨行业技术、政策、应用、需求或市场主题等独立概念对象，自身拥有名称与别名，不依赖通用 Entity 节点
    properties:
        id(概念标识): Text
            desc: 从既有 Concept Entity 无损保留的稳定标识，由 ENT 前缀直接连接 canonical lowercase UUID
            constraint: NotNull, Regular="^ENT[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        name(概念名称): Text
            desc: 概念的正式显示名称
            constraint: NotNull
        aliases(概念别名): Text
            desc: 概念用于匹配和检索的零个或多个稳定别名
            constraint: NotNull, MultiValue
        conceptType(概念类型): Text
            desc: technology 表示技术；policy 表示政策；application 表示应用；demand 表示需求；business_model 表示商业模式；company_ecosystem 表示企业生态；product_ecosystem 表示产品生态；event_narrative 表示事件叙事；market_theme 表示市场主题
            constraint: NotNull, Enum="technology,policy,application,demand,business_model,company_ecosystem,product_ecosystem,event_narrative,market_theme"
        definition(概念定义): Text
            desc: 概念业务含义与适用范围的正式定义
            constraint: NotNull
        reviewStatus(审核状态): Text
            desc: candidate 表示候选概念事实；approved 表示已批准概念事实
            constraint: NotNull, Enum="candidate,approved"
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的概念事实创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的概念事实最近变更时间
            constraint: NotNull
