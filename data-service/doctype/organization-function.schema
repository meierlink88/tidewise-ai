namespace Tidewise

OrganizationFunction(组织核心职能目录项): EntityType
    desc: Organization 的可维护核心职能目录项，以稳定英文机器码连接中文语义
    properties:
        id(核心职能标识): Text
            desc: 核心职能稳定主标识，由 OFN 前缀直接连接 canonical lowercase UUID
            constraint: NotNull, Regular="^OFN[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        code(核心职能代码): Text
            desc: 稳定英文机器码
            constraint: NotNull, Regular="^[A-Z][A-Z0-9_]*$"
        nameZh(中文名称): Text
            desc: 供人工阅读与 AI 语义理解的中文名称
            constraint: NotNull
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的目录项创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的目录项最近变更时间
            constraint: NotNull
