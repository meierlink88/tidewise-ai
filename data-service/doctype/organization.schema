namespace Tidewise

Organization(组织): EntityType
    desc: 跨国多边组织的独立权威对象，包括联盟、协会、国际机制、贸易集团和安全联盟。
    properties:
        code(组织代码): Text
            desc: 全大写稳定唯一机器码
            constraint: NotNull, Regular="^[A-Z][A-Z0-9_]*$"
        name(组织中文名称): Text
            desc: 组织中文名称
            constraint: NotNull
        nameEn(组织英文名称): Text
            desc: 组织英文名称
            constraint: NotNull
        category(组织形态): OrganizationCategory
            desc: 组织采用的唯一可维护形态分类
            constraint: NotNull
        function(核心职能): OrganizationFunction
            desc: 组织承担的唯一可维护核心职能
            constraint: NotNull
        domainTags(细化领域标签): OrganizationDomainTag
            desc: 与核心职能一致的零个或多个可维护细化领域标签
            constraint: MultiValue
        legalEntityCode(法人机构识别码): Text
            desc: 可选 ISO 17442 LEI；非独立法人实体为空
        bindingPowerLevel(约束力级别): Text
            desc: 约束力：HIGH强制约束；MEDIUM章程或契约约束；LOW无强制约束。
            constraint: Enum="HIGH,MEDIUM,LOW"
        influenceRating(影响力评级): Text
            desc: 影响力：S全球级；A大洲或专业领域级；B专业或局部级。
            constraint: Enum="S,A,B"
        strategicPositioning(战略定位): Text
            desc: 组织的可选战略定位描述
        coreImpactScope(核心影响范围): Text
            desc: 组织核心影响范围的可选描述
        foundingDocument(创立文件): Text
            desc: 组织创立文件或条约名称
        establishedDate(成立日期): Text
            desc: 组织成立的公历日期，格式为 YYYY-MM-DD
        headquartersCity(总部城市): Text
            desc: 组织总部所在城市
        headquartersSubdivisionId(总部行政区预留标识): Text
            desc: 为未来 Subdivision Object 预留的可空文本；当前没有外键、校验、查询或关系语义
        description(组织说明): Text
            desc: 组织的可选补充说明
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的组织事实创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的组织事实最近变更时间
            constraint: NotNull
    relations:
        region(归属区域): Region
            desc: 区域性组织在没有国家归属时可关联的 Region
