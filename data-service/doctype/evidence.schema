namespace Tidewise

Evidence(原子证据): EntityType
    desc: 从 Raw Evidence 清洗得到且可直接消费的最小完整业务命题
    properties:
        rawEvidenceId(所属原始证据标识): Text
            desc: 所属 Raw Evidence 的稳定标识
            constraint: NotNull, Regular="^RAW[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        isSplit(是否拆分): Text
            # TRUE：同一 Raw Evidence 产生多条 Atomic Evidence。
            # FALSE：同一 Raw Evidence 只产生一条 Atomic Evidence。
            desc: Data 根据完整 Evidence 集合基数派生的拆分状态
            constraint: NotNull, Enum="TRUE,FALSE"
        summary(事实摘要): Text
            desc: 最小完整业务命题的非空简洁摘要
            constraint: NotNull
        keywords(关键词): Text
            desc: 一至五个有序中文关键词的 JSON 数组
            constraint: NotNull
        actors(业务主体): Text
            desc: 实施核心业务动作的主体 JSON 数组，不以报道媒体替代业务主体
            constraint: NotNull
        action(核心动作): Text
            desc: 该业务命题唯一的非空核心动作
            constraint: NotNull
        objects(作用对象): Text
            desc: 核心动作作用对象的 JSON 数组
            constraint: NotNull
        stage(现实阶段): Text
            desc: 业务命题所处的现实阶段
            constraint: NotNull, Enum="OCCURRED,ANNOUNCED,EFFECTIVE,IMPLEMENTED,UPDATED,SUSPENDED,TERMINATED,EXPECTED"
        modality(事实情态): Text
            desc: 区分已发生事实、计划和规格说明
            constraint: NotNull, Enum="FACT,PLAN,SPEC"
        time(语义时间): Text
            desc: 原文时间、UTC 时间边界和精度组成的 JSON 对象
            constraint: NotNull
        jurisdictions(作用辖区): Text
            desc: 业务动作适用或影响辖区的 JSON 数组
            constraint: NotNull
        reason(发生原因): Text
            desc: 原文明确给出的业务原因，未知时为空
        method(执行方式): Text
            desc: 原文明确给出的执行方法，未知时为空
        metrics(业务指标): Text
            desc: 同一业务命题中相关指标的 JSON 数组
            constraint: NotNull
        attribution(信息归因): Text
            desc: 报道方与声称方组成的 JSON 对象，不替代业务主体
            constraint: NotNull
        createdAt(创建时间): Text
            desc: Data 为新记录生成的创建时间，历史记录可能为空
