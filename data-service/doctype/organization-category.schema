namespace Tidewise

OrganizationCategory(组织形态目录项): EntityType
    desc: Organization 的可维护组织形态目录项，以稳定英文机器码连接中文语义
    properties:
        code(组织形态代码): Text
            desc: 稳定英文机器码
            constraint: NotNull, Regular="^[A-Z][A-Z0-9_]*$"
        nameZh(中文名称): Text
            desc: 供人工阅读与 AI 语义理解的中文名称
            constraint: NotNull
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的目录项创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的目录项最近变更时间
            constraint: NotNull
