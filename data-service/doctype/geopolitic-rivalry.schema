namespace Tidewise

GeopoliticRivalry(地缘政治故事线): EntityType
    desc: 影响中国经济与投研的单一核心地缘政治命题
    properties:
        name(故事线中文名称): Text
            desc: 故事线的中文正式名称
            constraint: NotNull
        category(故事线分类): Text
            desc: 非枚举的故事线分类文案
            constraint: NotNull
        geopoliticDomainId(领域标识): Text
            desc: 故事线唯一主地缘政治领域的 GeopoliticDomain 标识
            constraint: NotNull
        coreProposition(核心命题): Text
            desc: 该故事线唯一需要跟踪和判断的核心内容
            constraint: NotNull
        coreActors(核心参与方): Text
            desc: 不解析为正式对象的核心参与方文本
            constraint: NotNull
        mainTransmission(主要传导): Text
            desc: 地缘政治变化对中国经济和可投研对象的主要传导链
            constraint: NotNull
        createdAt(创建时间): Text
            desc: PostgreSQL 生成的故事线创建时间
            constraint: NotNull
        updatedAt(更新时间): Text
            desc: PostgreSQL 生成的故事线最近变更时间
            constraint: NotNull
