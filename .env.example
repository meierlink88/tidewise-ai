# AgentRun secrets only. Non-secret runtime values live in internal/agentrun/config/config.<env>.yaml.
APP_ENV=dev
AGENTRUN_CONFIG_DIR=internal/agentrun/config
TZ=Asia/Shanghai
AGENTRUN_DATABASE_PASSWORD=agentrun-local-dev-password
AGENTRUN_DATABASE_URL=
AGENTRUN_SERVICE_TOKEN=replace-with-local-service-token
AGENTRUN_ADMIN_TOKEN=replace-with-local-admin-token
