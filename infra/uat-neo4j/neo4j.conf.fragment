# BEGIN TIDEWISE UAT NEO4J
dbms.security.procedures.unrestricted=apoc.*,gds.*
dbms.security.procedures.allowlist=apoc.*,gds.*
server.memory.heap.initial_size=1g
server.memory.heap.max_size=4g
server.memory.pagecache.size=1g
server.default_listen_address=127.0.0.1
server.default_advertised_address=127.0.0.1
server.bolt.enabled=true
server.bolt.listen_address=172.17.0.1:7687
server.bolt.advertised_address=release-openspg-neo4j:7687
server.http.enabled=true
server.http.listen_address=127.0.0.1:7474
server.http.advertised_address=127.0.0.1:7474
server.https.enabled=false
# END TIDEWISE UAT NEO4J
